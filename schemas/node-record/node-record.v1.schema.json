{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-workbench.local/schemas/node-record/workbench.node-1.json",
  "title": "Workbench NodeRecord v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "project_id", "canvas_id", "kind", "definition_ref", "renderer", "state", "title", "position", "size", "created_by", "created_at", "updated_at", "revision"],
  "properties": {
    "schema_version": {"const": "workbench.node/1"},
    "id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "canvas_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["asset", "skill", "artifact", "entity", "task", "approval", "group", "composite", "legacy"]},
    "definition_ref": {"$ref": "#/$defs/reference"},
    "renderer": {"$ref": "#/$defs/reference"},
    "state": {"enum": ["draft", "ready", "missing_input", "queued", "running", "waiting_user", "waiting_approval", "completed", "failed", "outdated", "frozen"]},
    "title": {"type": "string", "minLength": 1},
    "position": {"$ref": "#/$defs/position"},
    "size": {"$ref": "#/$defs/size"},
    "ports": {"$ref": "#/$defs/ports"},
    "input_bindings": {"type": "array", "items": {"oneOf": [{"$ref": "#/$defs/input_binding"}, {"$ref": "#/$defs/legacy_input_binding"}]}},
    "output_refs": {"type": "array", "items": {"$ref": "#/$defs/output_ref"}},
    "model_binding": {"type": ["object", "null"]},
    "config": {"type": "object"},
    "provenance_ref": {"type": ["string", "null"]},
    "created_by": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "revision": {"type": "integer", "minimum": 1},
    "metadata": {"type": "object"},
    "extensions": {"type": "object"}
  },
  "$defs": {
    "reference": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"type": {"type": "string", "minLength": 1}, "id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
    "position": {"type": "object", "additionalProperties": false, "required": ["x", "y"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}}},
    "size": {"type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": {"width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}}},
    "input_binding": {"type": "object", "additionalProperties": false, "required": ["id", "target", "source_type", "source_ref"], "properties": {"id": {"type": "string", "minLength": 1}, "target": {"type": "string", "minLength": 1}, "source_type": {"enum": ["asset_version", "artifact_version", "entity_ref", "entity_version", "collection", "literal"]}, "source_ref": {"type": "string", "minLength": 1}, "role": {"type": "string", "minLength": 1}, "order": {"type": "integer", "minimum": 0}, "enabled": {"type": "boolean"}, "metadata": {"type": "object"}}},
    "legacy_input_binding": {"type": "object", "additionalProperties": true},
    "ports": {"type": "object"},
    "output_ref": {"type": "object", "additionalProperties": false, "required": ["type", "id"], "properties": {"type": {"enum": ["asset_version", "artifact_version"]}, "id": {"type": "string", "minLength": 1}}}
  }
}
